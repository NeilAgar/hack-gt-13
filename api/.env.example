# Copy to .env at the repo root (gitignored) and fill in.
XAI_API_KEY=
# Check the current model name at https://docs.x.ai
XAI_MODEL=grok-4
# Seconds to wait for Grok before using the template; keep under the web app's 4 s API timeout
XAI_TIMEOUT_S=3
# Grok Voice line voice (see the voice list in the xAI docs)
XAI_VOICE=eve
# Where the voice page's "Back to StaffTrace" link goes
WEB_URL=http://localhost:3000
